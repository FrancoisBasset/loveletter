$burgundy: #350e18;
$parchment: #f3dfb5;

Header, Footer, Player > Label {
    background: $burgundy;
    color: $parchment;
}

#board {
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#central {
    width: auto;
    height: auto;
    align: center middle;
    visibility: hidden;
}

#central > Deck, #central > Discard {
    visibility: visible;
}

#central > Discard {
    margin-left: 2;
}

Card, Deck, Discard {
    width: 10;
    background: transparent;
}

Card {
    height: 8;
}

Deck, Discard {
    height: auto;
}

Player {
    width: 24;
    height: auto;
    position: absolute;
    layer: players;
    align-horizontal: center;
    background: transparent;
}

Player > Card {
    margin: 0 7;
}

Player > Label {
    width: 100%;
    text-align: center;
    padding: 0 1;
}

Player > Horizontal {
    width: 100%;
    height: auto;
    align-horizontal: center;
    padding: 1 0;
    background: transparent;

    visibility: hidden;
}

Player Card {
    visibility: visible;
}

Player > Horizontal > Card {
    margin: 0 1;
}

FavorToken {
    width: 2;
    height: 1;
    visibility: visible;
    background: transparent;
}
